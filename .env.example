# Copy to .env and adjust. Every value below is also the built-in default, so .env is only needed to
# override something. The services read environment variables; load the file into a WSL2 shell first:
#   set -a; source .env; set +a
# Settings that differ per experiment run (RUN_ID, SPARK_MASTER, CONTEXT_FRAMES) are usually set on the
# command line instead:  RUN_ID=E2-ctx4 CONTEXT_FRAMES=4 python vlm_service/service.py
# The defaults of CHANGE_THRESHOLD and CONTEXT_FRAMES were tuned with a webcam pointed at a room.

# --- Addresses (Phase 2 containers will use kafka:19092 and mongodb://mongo:27017) ---
# 127.0.0.1 rather than "localhost": Windows resolves localhost to ::1 first, but WSL2 forwards
# the IPv4 services only on 127.0.0.1.
KAFKA_BOOTSTRAP=127.0.0.1:9092
MONGO_URI=mongodb://127.0.0.1:27017

# --- Processor (processor/keyframe_job.py) ---
SPARK_MASTER="local[*]"
# Hamming distance (of 64 bits) to the last keyframe's dHash that counts as a scene change
# (still webcam scenes vary by 0-3 bits, a hand gesture by about 6-10)
CHANGE_THRESHOLD=6
# Select a keyframe at least this often per device, even for a still scene
HEARTBEAT_S=5
# Micro-batch trigger interval
TRIGGER_MS=500
# Upper bound on Kafka records read per micro-batch
MAX_OFFSETS_PER_TRIGGER=500
# Visual memory per device: the keyframes of the last this many seconds...
WINDOW_SECONDS=30
# ...at most this many of them (a full memory drops frames where they are densest, so it keeps
# covering the whole window even during long motion)...
WINDOW_STORE_MAX=32
# ...of which this many, spread evenly in time and always including the newest, go with a question...
WINDOW_MAX_FRAMES=8
# ...downscaled to at most this many pixels on the longest side (also used for the current frame)
WINDOW_IMAGE_MAX_SIDE=448
# Spark checkpoint directory (default ~/edge-vlm-data/checkpoint). Keep it in the Linux
# filesystem and delete it between experiment runs.
# CHECKPOINT_DIR=/home/<user>/edge-vlm-data/checkpoint

# --- VLM service (vlm_service/service.py) ---
MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
# Upper bound on the pixels of each image given to the model (a number or a product such as 448*448)
MAX_PIXELS=448*448
# Earlier frames of the question bundle given to the model (the newest ones), plus the current frame
# (0 = current frame only; at most WINDOW_MAX_FRAMES are in a bundle)
CONTEXT_FRAMES=8
MAX_NEW_TOKENS=128
# Kafka consumer group. A new group answers every question still in the queries topic (1 hour).
GROUP_ID=vlm-service
# Only needed for gated models; Qwen2.5-VL-3B-Instruct is not gated.
# HF_TOKEN=hf_...

# --- Both services ---
# Experiment tag stored in every MongoDB document (default: start time, e.g. 20261010-153000)
# RUN_ID=E1-local4-dev4
